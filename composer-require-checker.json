{
    "symbol-whitelist": [
        "Composer\\Composer",
        "Composer\\EventDispatcher\\EventSubscriberInterface",
        "Composer\\IO\\IOInterface",
        "Composer\\Package\\AliasPackage",
        "Composer\\Package\\Link",
        "Composer\\Package\\Package",
        "Composer\\Plugin\\PluginEvents",
        "Composer\\Plugin\\PluginInterface",
        "Composer\\Plugin\\PrePoolCreateEvent",
        "Composer\\Semver\\Constraint\\ConstraintInterface",
        "Composer\\Semver\\Constraint\\MultiConstraint",
        "Composer\\Semver\\Intervals",
        "Composer\\Semver\\VersionParser"
    ],
    "php-core-extensions": [
        "Core",
        "date",
        "json",
        "hash",
        "pcre",
        "Phar",
        "Reflection",
        "SPL",
        "random",
        "standard"
    ],
    "scan-files": []
}
